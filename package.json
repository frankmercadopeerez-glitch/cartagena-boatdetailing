{
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:finance": "node tests/finance-engine.test.js",
    "test:operations": "node tests/operations-engine.test.js",
    "test:operations-push": "node tests/operations-push.test.cjs",
    "build:css:finanzas": "tailwindcss -c tailwind.finanzas.config.js -i css/finanzas-tailwind-input.css -o css/finanzas-tailwind.css --minify",
    "build:css:tailwind": "tailwindcss -i css/tailwind-input.css -o css/tailwind.css --minify",
    "build:css:home": "node scripts/build-home-css.js",
    "build:css:styles": "cleancss -o css/styles.css css/styles.css",
    "build:js": "terser js/main.js -o js/main.js --compress --mangle && terser js/blog-catalog.js -o js/blog-catalog.js --compress --mangle",
    "build": "npm run build:css:tailwind && npm run build:css:styles && npm run build:css:home && npm run build:js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "clean-css-cli": "^5.6.3",
    "tailwindcss": "^3.4.19",
    "terser": "^5.48.0"
  }
}
